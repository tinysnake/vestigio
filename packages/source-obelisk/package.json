{
  "name": "@vestigio/source-obelisk",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only Obelisk source adapter: pinned CLI, capability probe, exact project scoping, bounded reads, SourceRef mapping.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "VESTIGIO_OBELISK_LIVE=1 vitest run test/live --testTimeout=180000 --hookTimeout=180000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@obelisk-apps/cli": "0.3.2",
    "@vestigio/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
